rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Misiones y sprites: todos leen, solo administradores publican (DLC)
    match /missions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sprites/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Progreso: cada jugador solo su documento
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
